{
  "expo": {
    "name": "TreinaComigo",
    "slug": "matchmaromba",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matchmaromba.app"
    },
    "android": {
      "package": "com.matchmaromba.app",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8F9"
      },
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização para encontrar pessoas e locais de treino próximos. Ela não é compartilhada publicamente."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Precisamos da galeria para você adicionar fotos ao perfil."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "9d9e0707-f77c-471b-933f-1adf29aaf1f7"
      }
    },
    "owner": "vieirajjr"
  }
}
